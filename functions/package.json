{
  "name": "travary-functions",
  "private": true,
  "description": "Travary server functions (Smart Import, trip visual profiles, family sharing).",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test \"lib/**/*.test.js\"",
    "test:emulator": "tsc && firebase emulators:exec --project demo-travary --only firestore \"'$npm_node_execpath' --test 'lib/**/*.itest.js'\"",
    "deploy": "firebase deploy --only functions"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3"
  }
}
