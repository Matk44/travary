{
  "name": "travary-rules-tests",
  "private": true,
  "description": "Firestore and Storage security-rule tests (run against the emulators).",
  "type": "module",
  "scripts": {
    "test": "cd .. && firebase emulators:exec --project demo-travary --only firestore,storage \"'$npm_node_execpath' --test --test-concurrency=1 'rules-tests/*.test.mjs'\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.19.0"
  }
}
