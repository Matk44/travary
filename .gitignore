.swiftpm/
migrate_working_dir/

# IntelliJ related (the shared run configurations are kept)
*.iml
*.ipr
*.iws
.idea/*
!.idea/runConfigurations/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Firebase CLI cache
.firebase/

# Archive of the pre-rebuild app (kept locally, too big for the repo)
legacy_v0_*.zip

# Gradle cache created by Android Studio at the project root
/.gradle/
