<?xml version="1.0" encoding="utf-8"?>
<!-- Small (2 × 2), medium (4 × 2, the default) or large (4 × 4): the
     provider picks the layout from the size it's given. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/countdown_widget_description"
    android:initialLayout="@layout/countdown_widget"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:previewImage="@drawable/countdown_widget_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
