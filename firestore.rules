rules_version = '2';

// Travary security rules.
//
//   trips/{tripId}                        title, theme, ownerId, memberIds[]
//   trips/{tripId}/bookings/{bookingId}   one booking
//
// A trip (and everything in it) is visible only to its members. Only the
// owner can delete a trip or change who's on it. Everything else is denied,
// including the old `users/` collection from the first version of the app.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMember(tripData) {
      return signedIn() && request.auth.uid in tripData.memberIds;
    }

    match /trips/{tripId} {
      allow read: if isMember(resource.data);

      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.auth.uid in request.resource.data.memberIds;

      allow update: if isMember(resource.data)
        && request.resource.data.ownerId == resource.data.ownerId
        && (request.resource.data.memberIds == resource.data.memberIds
            || resource.data.ownerId == request.auth.uid);

      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      match /bookings/{bookingId} {
        allow read, write: if isMember(
          get(/databases/$(database)/documents/trips/$(tripId)).data
        );
      }
    }
  }
}
