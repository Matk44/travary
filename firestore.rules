rules_version = '2';

// Travary security rules.
//
//   trips/{tripId}                        title, theme, themeSource, destination, ownerId, memberIds[],
//                                         checklist{}, packing{} (shared lists, any member)
//                                         visualProfile*, liveFlights{} (server only)
//   trips/{tripId}/bookings/{bookingId}   one booking + a copy of memberIds[]
//
//   users/{userId}                        purchases, mirrored by the server;
//                                         onboardingCompleted(At), the app's own
//   invites/{code}                        family invites, server only
//   tripPasses/{purchaseId}               claimed Holiday Passes, server only
//   watchedFlights, flightStatus, flightUsage, pushTokens, config
//                                         flight alerts and lookups, server only
//
// A trip (and everything in it) is visible only to its members. Only the
// owner can delete a trip or change who's on it. Only the server grants
// premium. Everything else is denied.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMember(tripData) {
      return signedIn() && request.auth.uid in tripData.memberIds;
    }

    // Written only by the server: premium, membership, invites, the
    // classifyTripVisuals function's profile, timestamp and request marker,
    // and flight alerts' live state of the trip's flights.
    function serverOnlyTripFields() {
      return ['premium', 'memberNames', 'invite',
              'visualProfile', 'visualProfileUpdatedAt', 'visualProfileRequest', 'liveFlights'];
    }

    // The look stays the traveller's to choose: a theme name, and who picks
    // it (automatic or manual).
    function validLook(data) {
      return (!('theme' in data) || (data.theme is string && data.theme.size() <= 40))
        && (!('themeSource' in data) || data.themeSource in ['auto', 'manual']);
    }

    function shortText(map, key, max) {
      return !(key in map) || (map[key] is string && map[key].size() <= max);
    }

    // Where the traveller says the trip goes ("Where to?"): a country
    // code, names and art-pack slugs, or null to remove it.
    function validDestination(data) {
      return !('destination' in data) || data.destination == null
        || (data.destination is map
          && data.destination.keys().hasOnly(['countryCode', 'countryName', 'region', 'regionSlug', 'city', 'citySlug'])
          && data.destination.countryCode is string && data.destination.countryCode.matches('[A-Z]{2}')
          && data.destination.countryName is string && data.destination.countryName.size() <= 120
          && shortText(data.destination, 'region', 120) && shortText(data.destination, 'regionSlug', 64)
          && shortText(data.destination, 'city', 120) && shortText(data.destination, 'citySlug', 64));
    }

    // "Before you go" and the packing list: shared items by id, changed one
    // at a time by any member. Maps, and not endless ones.
    function validChecklist(data) {
      return (!('checklist' in data) || (data.checklist is map && data.checklist.size() <= 100))
        && (!('packing' in data) || (data.packing is map && data.packing.size() <= 100));
    }

    match /trips/{tripId} {
      allow read: if isMember(resource.data);

      // `premium` (Plus travelling with the trip) is written only by the
      // server after a purchase, never by the app.
      // Member changes go through the sharing functions (which also update
      // each booking's copy), so the app can't change memberIds,
      // memberNames or invite at all after creating a trip.
      // The visual profile comes only from classifyTripVisuals (Admin SDK);
      // theme and themeSource stay the traveller's.
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && !request.resource.data.keys().hasAny(serverOnlyTripFields())
        && validLook(request.resource.data)
        && validDestination(request.resource.data)
        && validChecklist(request.resource.data);

      allow update: if isMember(resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(serverOnlyTripFields().concat(['ownerId', 'memberIds']))
        && validLook(request.resource.data)
        && validDestination(request.resource.data)
        && validChecklist(request.resource.data);

      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      // Writes check the trip itself and that the booking carries the
      // trip's current member list. (Writes reach the server in order, so a
      // trip created just before its first booking already exists here.)
      match /bookings/{bookingId} {
        function trip() {
          return get(/databases/$(database)/documents/trips/$(tripId)).data;
        }

        allow create, update: if isMember(trip())
          && request.resource.data.memberIds == trip().memberIds;
        allow delete: if isMember(trip());
      }
    }

    // A traveller's purchases (Plus, Trip Passes, free imports used),
    // mirrored here by the server from the store. The app may only record
    // that this account has been through onboarding (so another phone skips
    // it): those two fields, set to true and the server's time, nothing else.
    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['onboardingCompleted', 'onboardingCompletedAt'])
        && validOnboarding(request.resource.data);
      allow update: if signedIn() && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['onboardingCompleted', 'onboardingCompletedAt'])
        && validOnboarding(request.resource.data);
    }

    function validOnboarding(data) {
      return data.onboardingCompleted == true && data.onboardingCompletedAt == request.time;
    }

    // Reads, including the app's collection-group query over all bookings,
    // use the member list copied onto each booking. No trip lookup needed,
    // so a brand-new trip's bookings are readable straight away.
    match /{path=**}/bookings/{bookingId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;
    }
  }
}
